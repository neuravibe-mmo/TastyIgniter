    "paths": {
        "/token": {
            "summary": "Generate API Token",
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Generate API Access Token",
                "description": "Generate Sanctum bearer token for customer or admin",
                "operationId": "65f9388a794dc7171d46a8c150a5a6cc",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "customer@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "secret"
                                    },
                                    "device_name": {
                                        "type": "string",
                                        "example": "my_mobile_app"
                                    },
                                    "is_admin": {
                                        "type": "integer",
                                        "example": 0
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Token generated successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status_code": {
                                            "type": "integer",
                                            "example": 201
                                        },
                                        "token": {
                                            "type": "string",
                                            "example": "1|abc123xyz..."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                }
            },
            "servers": [
                {
                    "url": "/api",
                    "description": "TastyIgniter API Server Base"
                }
            ]
        },
